# Copy this file to .env and fill in your own values. .env is never committed.
# SSH alias or user@hostname used by scripts/deploy.sh.
DPT_DEPLOY_HOST=
# Reader IP address or hostname. Saved web settings override this default.
DPT_ADDRESS=
# Optional private IPv4 address on the server for LAN publishing.
# Set this or DPT_ADDRESS for the first deployment.
APP_LISTEN_ADDRESS=
# Optional comma-separated server hostnames accepted by the web application.
APP_ALLOWED_HOSTS=
# Optional bookmark URL; successful deployment also saves its URL locally.
DPT_WEB_URL=
